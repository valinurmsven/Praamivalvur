{
  "expo": {
    "name": "Praamivalvur",
    "slug": "praamivalvur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ee.valinurmsven.praamivalvur"
    },

    "android": {
      "package": "ee.valinurmsven.praamivalvur",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-notifications",
      "expo-secure-store"
    ],

    "notification": {
      "icon": "./assets/icon.png"
    },

    "extra": {
      "eas": {
        "projectId": "ce184ab9-55c9-4442-a850-e7a0e429b90d"
      }
    }
  }
}
